<UserControl x:Class="ClaudeUsageTray.UI.Controls.ColorPickerBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Orientation="Horizontal">
        <!-- Swatch button: shows the color over a checkerboard (so transparency is visible) and opens the presets. -->
        <Button x:Name="SwatchButton" Width="32" Height="32" Padding="0" Margin="0,0,6,0" Click="OnSwatchClick"
                ToolTip="{Binding Text, ElementName=HexBox}">
            <Grid Width="22" Height="22">
                <Rectangle>
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="White" Geometry="M0,0 H2 V2 H0Z" />
                                    <GeometryDrawing Brush="LightGray" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z" />
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle x:Name="Preview" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" />
            </Grid>
        </Button>
        <TextBox x:Name="HexBox" Width="104" VerticalContentAlignment="Center" FontFamily="Consolas"
                 LostFocus="OnHexLostFocus" KeyDown="OnHexKeyDown" />
        <Popup x:Name="PresetPopup" PlacementTarget="{Binding ElementName=SwatchButton}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="6">
                <WrapPanel x:Name="PresetPanel" Width="196" />
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
